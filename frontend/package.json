    "recharts": "^2.12.7",
    "sweetalert2": "^11.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^7.0.2",
    "vite": "^5.3.1",
    "vite-plugin-singlefile": "^2.3.4"
